---
/**
 * @file The Writing page: every article, newest first, each linking to its
 * page here where it has one and to LinkedIn otherwise, and a call to follow
 * Tomer on LinkedIn. It is served at `/blog/`, since existing links point
 * there.
 */

import Badge from "../design-system/Badge.astro";
import ButtonLink from "../design-system/ButtonLink.astro";
import { ArrowRight } from "../design-system/icons.ts";
import PageDocument from "../layouts/PageDocument.astro";
import { PERSON } from "../person.ts";
import ArticleCard from "../writing/articles/ArticleCard.astro";
import { loadArticles } from "../writing/articles/collection.ts";
import PublishedDate from "../writing/articles/PublishedDate.astro";
import { WRITING } from "../writing/writing.ts";

const articles = await loadArticles();
---

<PageDocument description={WRITING.description} pageName="Writing">
  <main class="mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:py-20" id="main-content">
    <div class="mb-10">
      <div class="mb-4 flex items-center gap-3">
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Writing</h1>
        <Badge size="md" variant="accent">Coming Soon</Badge>
      </div>
      <p class="max-w-xl text-lg text-text-secondary">
        I write about distributed systems, open source leadership, and the
        philosophy of software engineering.
      </p>
    </div>

    <div class="mb-10">
      <h2
        class="mb-4 text-sm font-semibold tracking-wider text-text-muted uppercase"
      >
        Featured on LinkedIn
      </h2>
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
        {
          articles.map((article) => (
            <ArticleCard article={article} badge="LinkedIn">
              <PublishedDate
                article={article}
                class="text-xs text-text-muted"
              />
            </ArticleCard>
          ))
        }
      </div>
    </div>

    <div class="rounded-xl border border-border bg-bg-surface p-6 text-center">
      <p class="mb-3 text-text-secondary">
        Blog posts are on the way. In the meantime, follow me on LinkedIn for
        updates.
      </p>
      <ButtonLink href={PERSON.linkedinUrl}>
        Follow on LinkedIn
        <ArrowRight className="h-4 w-4" />
      </ButtonLink>
    </div>

    <div class="mt-8">
      <a class="text-sm text-accent hover:underline" href="/">← Back to home</a>
    </div>
  </main>
</PageDocument>
