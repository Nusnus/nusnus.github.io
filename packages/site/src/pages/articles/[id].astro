---
/**
 * @file `/articles/<id>/`: an article's own page, for each article with a body,
 * with a reading-progress bar, its header, its body and links back home and to
 * LinkedIn, where it first appeared.
 */

import type { GetStaticPaths, InferGetStaticPropsType } from "astro";

import { render } from "astro:content";

import Badge from "../../design-system/Badge.astro";
import BrandIcon from "../../design-system/BrandIcon.astro";
import { ArrowRight } from "../../design-system/icons.ts";
import { linkTarget } from "../../design-system/link-target.ts";
import PageDocument from "../../layouts/PageDocument.astro";
import { PERSON } from "../../person.ts";
import { hasPage, readingMinutes } from "../../writing/articles/article.ts";
import { loadArticles } from "../../writing/articles/collection.ts";
import PublishedDate from "../../writing/articles/PublishedDate.astro";
import BackHomeLink from "../../writing/BackHomeLink.astro";
import { ReadingProgress } from "../../writing/reading-progress.ts";

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

export const getStaticPaths = (async () =>
  (await loadArticles()).filter(hasPage).map((article) => ({
    params: { id: article.id },
    props: { article },
  }))) satisfies GetStaticPaths;

const { article } = Astro.props;
const { description, linkedinUrl, publishedAt, tags, title } = article.data;
const { Content } = await render(article);
---

<PageDocument
  article={{ publishedAt, tags }}
  description={description}
  pageName={title}
>
  <div
    class="fixed top-0 right-0 left-0 z-50 h-0.5 origin-left scale-x-0 bg-accent/80"
    id={ReadingProgress.ELEMENT_ID}
  >
  </div>

  <main id="main-content">
    <article
      class="mx-auto max-w-4xl px-4 pt-8 pb-12 sm:px-8 sm:pt-16 sm:pb-24 lg:pt-20"
    >
      <nav class="mb-8 sm:mb-10">
        <BackHomeLink />
      </nav>

      <header class="mb-10 sm:mb-14">
        <div class="mb-4 flex flex-wrap items-center gap-2">
          {tags.map((tag) => <Badge>{tag}</Badge>)}
        </div>
        <h1
          class="mb-4 text-3xl leading-tight font-bold tracking-tight text-text-primary sm:text-4xl sm:leading-tight lg:text-5xl lg:leading-tight"
        >
          {title}
        </h1>
        <p
          class="mb-6 text-lg leading-relaxed text-text-secondary sm:text-xl sm:leading-relaxed"
        >
          {description}
        </p>
        <div class="mb-6 h-px bg-accent/30"></div>
        <div
          class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
        >
          <div class="flex items-center gap-3">
            <img
              alt=""
              class="rounded-full"
              height="40"
              src={PERSON.staticAvatarUrl}
              width="40"
            />
            <div>
              <p class="text-sm font-semibold text-text-primary">
                {PERSON.name}
              </p>
              <div class="flex items-center gap-2 text-xs text-text-muted">
                <PublishedDate article={article} />
                <span aria-hidden="true">·</span>
                <span>{readingMinutes(article)} min read</span>
              </div>
            </div>
          </div>
          <a
            class="inline-flex items-center gap-2 rounded-lg border border-border bg-bg-surface px-3 py-1.5 text-xs font-medium text-text-muted transition-all hover:border-accent/40 hover:text-accent"
            href={linkedinUrl}
            {...linkTarget(linkedinUrl)}
          >
            <BrandIcon brand="linkedin" class="h-3.5 w-3.5" />
            View on LinkedIn
          </a>
        </div>
      </header>

      <div
        class="prose prose-lg max-w-none prose-theme prose-headings:font-bold prose-headings:tracking-tight prose-h2:mt-12 prose-h2:mb-4 prose-h2:border-l-2 prose-h2:border-accent/20 prose-h2:pl-4 prose-h2:text-2xl sm:prose-h2:text-3xl prose-h3:mt-8 prose-h3:mb-3 prose-h3:text-xl sm:prose-h3:text-2xl prose-p:mb-6 prose-p:leading-relaxed prose-a:no-underline hover:prose-a:underline prose-blockquote:border-accent/30 prose-strong:font-semibold prose-code:font-mono"
      >
        <Content />
      </div>

      <footer class="mt-14 sm:mt-20">
        <div class="mb-8 h-px bg-border"></div>
        <div class="flex items-center justify-between">
          <BackHomeLink />
          <a
            class="inline-flex items-center gap-1.5 text-sm text-text-muted transition-colors hover:text-accent"
            href={linkedinUrl}
            {...linkTarget(linkedinUrl)}
          >
            Read on LinkedIn
            <ArrowRight className="h-4 w-4" />
          </a>
        </div>
      </footer>
    </article>
  </main>

  <script>
    import { ReadingProgress } from "../../writing/reading-progress.ts";

    ReadingProgress.attach(window);
  </script>
</PageDocument>
