---
/**
 * @file The mobile drawer's markup: a modal dialog, below the `md` breakpoint,
 * holding Tomer's role, the section links, his GitHub numbers and his social
 * links, with a button that closes it. `mobile-drawer.ts` opens and closes it.
 */

import IconButton from "../../design-system/IconButton.astro";
import { X } from "../../design-system/icons.ts";
import ContributionTotal from "../../github-data/slots/contributions/ContributionTotal.astro";
import ContributorRankings from "../../github-data/slots/repositories/ContributorRankings.astro";
import NavLinks from "../NavLinks.astro";
import RoleSummary from "../RoleSummary.astro";
import SocialLinks from "../SocialLinks.astro";
import { MobileDrawer } from "./mobile-drawer.ts";
---

<dialog
  aria-label="Mobile navigation"
  class="fixed inset-y-0 right-0 left-auto h-full max-h-none w-72 max-w-none translate-x-full overflow-y-auto bg-bg-base text-text-primary shadow-xl transition-[translate,overlay,display] transition-discrete duration-300 ease-in-out backdrop:bg-black/50 backdrop:backdrop-blur-sm open:translate-x-0 md:hidden starting:open:translate-x-full"
  id={MobileDrawer.DRAWER_ID}
>
  <div class="min-h-full">
    <form class="flex items-center justify-end px-4 py-3" method="dialog">
      <IconButton
        aria-label="Close navigation menu"
        class="hover:text-text-primary"
      >
        <X className="h-5 w-5" />
      </IconButton>
    </form>
    <div class="px-5 pb-6">
      <RoleSummary class="mb-4" />
      <div class="mb-4">
        <NavLinks placement="drawer" />
      </div>
      <div class="mb-4 border-t border-border pt-4">
        <ContributionTotal />
        <ContributorRankings />
      </div>
      <SocialLinks />
    </div>
  </div>
</dialog>

<script>
  import { MobileDrawer } from "./mobile-drawer.ts";

  MobileDrawer.attach(window);
</script>
