{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The worker's Cloudflare name stays "ai-proxy", a leftover of an earlier
  // AI proxy: its GITHUB_TOKEN secret is stored under this name, and renaming
  // the worker would deploy a new worker without it.
  "name": "ai-proxy",
  // Cloudflare supports every compatibility date forever, so this one never
  // lapses; move it forward only to adopt newer runtime behaviour:
  // https://developers.cloudflare.com/workers/configuration/compatibility-dates/
  "compatibility_date": "2026-11-03",
  "main": "src/worker.ts",
  // Wrangler turns observability on by default only for Workers created
  // after this one: https://developers.cloudflare.com/workers/wrangler/configuration/#observability
  "observability": {
    "enabled": true,
  },
  // `wrangler deploy` refuses to deploy while a required secret is unset, and
  // `wrangler types` types each one as a string on `Env`.
  "secrets": {
    "required": ["GITHUB_TOKEN"],
  },
  // The version each response names, so a deploy can wait until the worker
  // serves the version it deployed:
  // https://developers.cloudflare.com/workers/runtime-apis/bindings/version-metadata/
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
}
