{
  "name": "nusnus.github.io",
  "private": true,
  "description": "Tomer Nosrati's portfolio site and the worker that serves its GitHub data.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "audit:workflows": "ZIZMOR_OFFLINE=${ZIZMOR_OFFLINE:-true} zizmor --strict-collection --persona=auditor .",
    "await:worker-version": "node scripts/worker-version/main.ts",
    "check": "bun run check:pinned-tools && bun run generate && bun run --parallel --no-exit-on-error audit:workflows check:test-mirrors format:check knip lint lint:renovate lint:shell lint:workflows test test:smoke typecheck",
    "check:expiries": "node scripts/expiries/main.ts",
    "check:pinned-tools": "node scripts/pinned-tools/main.ts",
    "check:test-mirrors": "node scripts/test-mirrors/main.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate": "bun run --filter './packages/*' generate",
    "install:browser-libraries": "bun run --cwd packages/site playwright install-deps chromium",
    "knip": "knip",
    "lint": "eslint --max-warnings 0 .",
    "lint:renovate": "renovate-config-validator --strict",
    "lint:shell": "git ls-files -z --cached --others --exclude-standard '*.sh' | xargs -0 shellcheck",
    "lint:workflows": "actionlint",
    "record:services": "node scripts/record-exchanges/main.ts",
    "setup-repository": "scripts/setup-repository.sh",
    "test": "vitest run --coverage",
    "test:mutation": "stryker run stryker.config.ts",
    "test:smoke": "bun run --filter ./packages/site test:smoke",
    "typecheck": "tsc && bun run --filter './packages/*' typecheck",
    "update:worker-replies": "vitest run --project worker --update"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": ">=1.5.1",
    "@eslint-community/eslint-plugin-eslint-comments": ">=4.8.1",
    "@eslint-react/eslint-plugin": ">=5.28.8",
    "@eslint/css": ">=2.0.1",
    "@eslint/js": ">=10.0.1",
    "@eslint/markdown": ">=8.0.3",
    "@nusnus/github-data": "workspace:*",
    "@stryker-mutator/api": ">=10.1.1",
    "@stryker-mutator/core": ">=10.1.1",
    "@stryker-mutator/vitest-runner": ">=10.1.1",
    "@tsconfig/node26": ">=26.0.1",
    "@tsconfig/strictest": ">=2.0.8",
    "@types/node": ">=26.6.6",
    "@vitest/coverage-istanbul": ">=5.1.0",
    "eslint": ">=10.14.0",
    "eslint-plugin-astro": ">=3.2.1",
    "eslint-plugin-jsdoc": ">=65.4.3",
    "eslint-plugin-jsonc": ">=3.4.2",
    "eslint-plugin-jsx-a11y-x": ">=0.2.0",
    "eslint-plugin-n": ">=18.5.0",
    "eslint-plugin-package-json": ">=1.14.0",
    "eslint-plugin-perfectionist": ">=5.13.0",
    "eslint-plugin-react-hooks": ">=7.1.1",
    "eslint-plugin-toml": ">=1.5.0",
    "eslint-plugin-yml": ">=3.9.0",
    "happy-dom": ">=21.0.4",
    "jiti": ">=2.7.0",
    "knip": ">=6.44.1",
    "lefthook": ">=2.2.2",
    "msw": ">=3.0.3",
    "prettier": ">=3.9.10",
    "prettier-plugin-astro": "~0.14.1",
    "prettier-plugin-css-order": ">=2.2.0",
    "prettier-plugin-sh": ">=0.20.2",
    "prettier-plugin-tailwindcss": ">=0.8.1",
    "prettier-plugin-toml": ">=4.1.0",
    "renovate": ">=44.210.1",
    "tailwind-csstree": ">=0.4.2",
    "typescript": "~6.0.3",
    "typescript-eslint": ">=8.72.1",
    "vitest": ">=5.1.0"
  }
}
